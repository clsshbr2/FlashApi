# =============================================================================
# FLASH API - VARIÁVEIS DE AMBIENTE
# Copie este arquivo para ".env" e ajuste os valores.
# Todas as variáveis abaixo são realmente lidas pela API.
# =============================================================================


# =============================================================================
# SERVIDOR
# =============================================================================

# Porta da API
PORT=3000

# Protocolo de acesso à API. Com "https" o cookie de sessão do painel vira "secure".
# Opções: http | https
PROTOCOLO=http

# Ambiente. Em "development" os erros 500 mostram a mensagem detalhada.
# Opções: development | production
NODE_ENV=production

# Origens liberadas no CORS (separadas por vírgula). "*" libera qualquer origem.
# Exemplo restrito: CORS_ORIGINS=https://meusite.com,http://localhost:3000
CORS_ORIGINS=*

# Fuso horário da aplicação
TZ=America/Sao_Paulo

# Versão da API exibida no painel/status
VERSAO=1.0.7


# =============================================================================
# LOGS
# =============================================================================

# Nível de log da API
# Opções: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Nível de log da zapo (conexão com o WhatsApp). Se omitido, usa LOG_LEVEL.
# Opções: error | warn | info | debug | trace
WA_LOG_LEVEL=error


# =============================================================================
# SEGURANÇA - API KEY GLOBAL
# =============================================================================

# Chave obrigatória para criar/listar/deletar sessões. TROQUE por um valor secreto.
GLOBAL_API_KEY=troque-por-uma-chave-secreta


# =============================================================================
# PAINEL ADMINISTRATIVO (MANAGER)
# =============================================================================

# Habilita o painel web em /manager
# Opções: true | false
MANAGER=true

# Usuário administrador
LOGIN_MANAGER_ADMIN=admin

# Usuário comum
LOGIN_MANAGER_USER=user

# Senha do administrador. TROQUE.
SENHA_MANAGER_ADMIN=troque-esta-senha


# =============================================================================
# SESSÕES DO WHATSAPP
# =============================================================================

# Nome do sistema operacional exibido em "Aparelhos conectados" no WhatsApp
SESSION_PHONE_CLIENT=FlashApi

# Navegador exibido em "Aparelhos conectados"
# Opções: Chrome | Firefox | Edge | Opera | Safari
SESSION_PHONE_NAME=Chrome

# Versão do WhatsApp Web anunciada na conexão: [major, minor, patch]
VERSION_ZAP=[2, 3000, 1043914743]

# Quantas vezes um QR Code pode ser gerado antes da sessão ser descartada
LIMITE_QRCODE=10

# Ignora mensagens de status/stories (status@broadcast)
# Opções: true | false
IGNORE_BROADCAST=true


# =============================================================================
# WEBHOOK GLOBAL
# =============================================================================

# Envia todos os eventos de todas as sessões para uma URL
# Opções: true | false
ENABLE_GLOBAL_WEBHOOK=false

# URL que receberá os eventos
GLOBAL_WEBHOOK_URL=http://localhost:3001/webhook

# Tentativas de envio em caso de falha
GLOBAL_WEBHOOK_ATTEMPTS=4


# =============================================================================
# WEBSOCKET GLOBAL
# =============================================================================

# Habilita o WebSocket em /ws com os eventos de todas as sessões
# Opções: true | false
ENABLE_WEBSOCKET=false

# Chave usada para autenticar no WebSocket global. TROQUE.
GLOBAL_WEBSOCKET_SECRET=troque-por-outra-chave-secreta


# =============================================================================
# BANCO DE DADOS (PostgreSQL)
# =============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=troque-a-senha
DB_DATABASE=flashapi

# Máximo de conexões do pool da API
DB_CONNECTION_LIMIT=20

# Limite de requisições aguardando conexão (0 = ilimitado)
QUEUELIMIT=0

# Quantos registros (mensagens/chats/contatos) os workers gravam por lote
BATCH_SIZE=500


# =============================================================================
# REDIS
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379

# Deixe vazio se o Redis não tiver senha
REDIS_PASS=


# =============================================================================
# PROXY GLOBAL
# (cada sessão também pode ter um proxy próprio, que tem prioridade sobre este)
# =============================================================================

# Usa o proxy global em todas as sessões sem proxy próprio
# Opções: true | false
PROXY_STATE=false

# Opções: http | https
PROXY_PROTOCOL=http
PROXY_HOST=proxy.exemplo.com
PROXY_USERNAME=usuario
PROXY_PASSWORD=senha

# Porta fixa do proxy
PROXY_PORT=8080

# Para sortear a porta a cada inicialização (proxies rotativos), REMOVA PROXY_PORT e use:
# PROXY_PORT_MIN=10000
# PROXY_PORT_MAX=20000


# =============================================================================
# ZAPO (opcional)
# =============================================================================

# Faz a zapo também guardar mensagens/chats/contatos no PostgreSQL (tabelas zapo_*)
# e sincronizar o histórico. Normalmente NÃO é necessário: a API já tem suas tabelas.
# Opções: true | false
ZAPO_STORE_HISTORICO=false

# Com ZAPO_STORE_HISTORICO=true, pede o histórico completo ao conectar
# Opções: true | false
SYNC_SESSIONS=false

# Conexões do pool PostgreSQL usado pela zapo para guardar credenciais e chaves
ZAPO_DB_POOL_MAX=10
