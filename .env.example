# =============================================================================
# CONFIGURAÇÕES GERAIS DA API
# =============================================================================

# Host/IP onde a API será iniciada
HOST=http://localhost:3000

# Protocolo utilizado pela API
# Opções: http | https
PROTOCOLO=http

# Porta da API
PORT=3000


# Nível de log da API
# Opções: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Nível de log da Baileys
# Opções: fatal | error | warn | info | debug | trace | silent
BAILEYS_LOG_LEVEL=error

# Versão da API
VERSAO=1.0.6

# Sincroniza automaticamente todas as sessões ao iniciar a API
# Opções: true | false
SYNC_SESSIONS=true
#broadcast
IGNORE_BROADCAST=true

# Timezone da aplicação
TZ=America/Sao_Paulo


# =============================================================================
# CORS
# =============================================================================

# Permite requisições de qualquer origem
CORS_ORIGINS=*

# Caso queira restringir:
# CORS_ORIGINS=https://meusite.com,http://localhost:3000


# =============================================================================
# PAINEL ADMINISTRATIVO (MANAGER)
# =============================================================================

# Habilita ou desabilita o painel administrativo
# Opções: true | false
MANAGER=true

# Usuário administrador
LOGIN_MANAGER_ADMIN=admin

# Usuário comum
LOGIN_MANAGER_USER=user

# Senha do administrador
SENHA_MANAGER_ADMIN=asdasdas

# Para desativar completamente o painel:
# MANAGER=false


# =============================================================================
# CONFIGURAÇÕES PADRÃO DAS SESSÕES
# =============================================================================

# Nome do dispositivo exibido no WhatsApp
SESSION_PHONE_CLIENT=testeflash
VERSION_ZAP=[2, 3000, 1043914743]

# Nome do navegador exibido no WhatsApp
# Opções:
# Chrome
# Firefox
# Edge
# Opera
# Safari
SESSION_PHONE_NAME=Chrome


# =============================================================================
# API KEY GLOBAL
# =============================================================================

# Obrigatória para criação de novas sessões
GLOBAL_API_KEY=ASDASDSA55WQ88E55R8ER5T2QW5E5Q


# =============================================================================
# WEBHOOK GLOBAL
# =============================================================================

# Habilita o webhook global
# Opções: true | false
ENABLE_GLOBAL_WEBHOOK=false

# URL que receberá todos os eventos
GLOBAL_WEBHOOK_URL=http://localhost:3001/teste

# Quantidade máxima de tentativas em caso de falha
GLOBAL_WEBHOOK_ATTEMPTS=4

# Lista de eventos enviados ao webhook
# Separados por vírgula
GLOBAL_WEBHOOK_EVENTS=connection_update,creds_update,messaging_history_set,messaging_history_status,chats_upsert,chats_update,lid_mapping_update,chats_delete,presence_update,contacts_upsert,contacts_update,messages_delete,messages_update,messages_media_update,messages_upsert,messages_reaction,message_receipt_update,groups_upsert,groups_update,group_participants_update,group_join_request,group_member_tag_update,blocklist_set,blocklist_update,call,labels_edit,labels_association,newsletter_reaction,newsletter_view,newsletter_participants_update,newsletter_settings_update,message_capping_update,chats_lock,settings_update


# =============================================================================
# WEBSOCKET GLOBAL
# =============================================================================

# Habilita o WebSocket global
# Opções: true | false
ENABLE_WEBSOCKET=false

# Chave utilizada para autenticação no WebSocket
GLOBAL_WEBSOCKET_SECRET=ASDASDSA55WQ88E55R8ER5T2QW5E5Q


# =============================================================================
# BANCO DE DADOS
# =============================================================================

# Tipo do banco de dados
# Opções: postgres | mysql
DB_TYPE=postgres

# Host/IP do banco
DB_HOST=asdasd

# Porta
DB_PORT=5439

# Usuário
DB_USER=postgres

# Senha
DB_PASSWORD=asdad

# Nome do banco
DB_DATABASE=testelocal

# Quantidade máxima de conexões
DB_CONNECTION_LIMIT=60

# Limite da fila de conexões
# 0 = ilimitado
QUEUELIMIT=0


# =============================================================================
# REDIS
# =============================================================================

# Host/IP
REDIS_HOST=asdsadasd

# Porta
REDIS_PORT=5438

# Senha (opcional)
REDIS_PASS=asdsadasd


# =============================================================================
# QR CODE
# =============================================================================

# Quantidade máxima de QR Codes gerados simultaneamente
LIMITE_QRCODE=10


# =============================================================================
# REMOÇÃO AUTOMÁTICA DE SESSÕES
# =============================================================================

# Remove automaticamente sessões desconectadas
# Opções: true | false
DELETE_SESAO_DISCONECT=true

# Tempo para remover a sessão (em horas)
TEMP_DELETE_SESSAO=5


# =============================================================================
# PROXY
# =============================================================================

# Habilita uso de Proxy
# Opções: true | false
PROXY_STATE=false

# Protocolo
# Opções: http | https | socks5
PROXY_PROTOCOL=http

# Host/IP do Proxy
PROXY_HOST=gw.dataimpulse.com

# Usuário
PROXY_USERNAME=asdasdasd

# Senha
PROXY_PASSWORD=adasdasdsa

# Porta fixa do Proxy
PROXY_PORT=823

# Caso queira utilizar portas aleatórias,
# remova PROXY_PORT e utilize:

# Porta mínima
PROXY_PORT_MIN=10000

# Porta máxima
PROXY_PORT_MAX=20000

# =============================================================================
# PROVEDOR DE WHATSAPP (BAILEYS x ZAPO)
# =============================================================================

# Biblioteca usada para conectar ao WhatsApp. Exige reiniciar a API para trocar.
# Opções: baileys | zapo
# Veja docs/MIGRACAO_ZAPO.md antes de usar "zapo" em produção.
WA_PROVIDER=baileys

# (zapo) Faz a zapo também guardar mensagens/chats/contatos no PostgreSQL
# (tabelas zapo_*). Normalmente NÃO é necessário: a API já tem suas tabelas.
# Opções: true | false
ZAPO_STORE_HISTORICO=false

# (zapo) Tamanho máximo do pool de conexões do store da zapo
ZAPO_DB_POOL_MAX=10
