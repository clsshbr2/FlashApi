<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <title>Painel do Cliente | Flash API</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
      rel="stylesheet"
    />

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery.min.js"></script>
    <link href="/css/futuristic-theme.css" rel="stylesheet" />
  </head>

  <body class="panel-page user-page dashboard-page">
    <!-- Navbar -->
    <nav
      class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-primary"
    >
      <div class="container-fluid">
        <a class="navbar-brand text-primary fw-bold" href="#"
          ><i class="bi bi-lightning-charge-fill me-1"></i> Flash API</a
        >
        <div class="d-flex align-items-center gap-3">
          <span class="text-light small-muted d-none d-md-inline"
            ><strong class="text-secondary" id="name_hello"></strong
          ></span>
          <a href="/manager/logout" class="btn btn-sm btn-danger">
            <i class="bi bi-box-arrow-right me-1"></i> Sair
          </a>
          <% if (redirect && redirect !== '') { %>
          <a href="<%= redirect %>" class="btn btn-sm btn-warning">
            <i class="bi bi-box-arrow-right me-1"></i> Voltar
          </a>
          <% } %>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <div class="row mb-3">
        <div class="col-12">
          <h2 class="text-primary dashboard-title">Painel do Cliente</h2>
          <p class="small-muted mb-0">
            Gerencie sua instância com segurança: conexão, webhook, eventos e
            recursos.
          </p>
        </div>
      </div>

      <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <div id="userInfo" data-apikey="<%= apikey %>"></div>

      <section>
        <div class="data-panel p-3 mb-3">
          <h6 class="text-primary mb-2">Informações da Instância</h6>
          <div class="row g-2">
            <div class="col-md-6">
              <div class="small-muted">Apikey da sessão</div>
              <div id="info_instancia_apikey" class="fw-semibold">-</div>
            </div>
            <div class="col-md-6">
              <div class="small-muted">Status atual</div>
              <div id="info_instancia_status" class="fw-semibold">-</div>
            </div>
            <div class="col-md-6">
              <div class="small-muted">Nome da sessão</div>
              <div id="info_instancia_nome" class="fw-semibold"></div>
            </div>
            <div class="col-md-6">
              <div class="small-muted">Número</div>
              <div id="info_instancia_numero" class="fw-semibold">-</div>
            </div>
          </div>
          <hr />

          <!-- QR Code -->
          <div id="qr-container" class="text-center d-none">
            <h6 class="text-primary mb-3">
              <i class="bi bi-qr-code me-2"></i>QR Code
            </h6>

            <img
              id="qr-code-img"
              class="img-fluid rounded border shadow-sm"
              style="max-width: 280px"
            />

            <div id="qr-code-info" class="alert alert-warning mt-3 mb-0">
              Escaneie o QR Code com seu WhatsApp.
            </div>
          </div>

          <!-- Informações Extras -->
          <div
            id="info-detalhes"
            class="alert alert-light border mt-3 d-none"
          ></div>
        </div>

        <div class="card card-instance mb-3">
          <div
            class="card-header d-flex justify-content-between align-items-center"
            id="card_webhook_togget"
            style="cursor: pointer"
          >
            <div>
              <h2 class="text-primary mb-0">Configure seu webhook</h2>
              <small class="text-muted">
                Clique para expandir as configurações
              </small>
            </div>

            <i
              id="icon-card-webhook"
              class="bi bi-chevron-down fs-4 text-secondary"
            ></i>
          </div>
          <div class="card-body d-none" id="card_webhook">
            <form action="" method="POST" id="form_webhook">
              <div class="mb-3">
                <label class="form-label text-secondary">🔗 URL Webhook</label>
                <div class="input-group">
                  <span class="input-group-text border-primary border-2"
                    >URL:</span
                  >
                  <input
                    type="text"
                    id="webhook-url"
                    name="webhook_url"
                    class="form-control border-primary border-2"
                    placeholder="https://meuwebhook.com/api/receber"
                  />
                  <button
                    type="button"
                    id="btn-testar-webhook"
                    class="btn btn-outline-info"
                  >
                    <i class="bi bi-broadcast me-1"></i> Testar webhook
                  </button>
                </div>
                <div class="form-check mt-2">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="webhook_status"
                    name="webhook_status"
                  />
                  <label class="form-check-label" for="webhook-status"
                    >Status Webhook</label
                  >
                </div>
              </div>
              <div class="card card-instance mb-3">
                <div id="events-container" class="row g-2"></div>
              </div>
              <div class="d-flex justify-content-center">
                <button class="btn btn-sm btn-success">Salvar Webhook</button>
              </div>
            </form>
          </div>
        </div>

        <div class="card card-instance mb-3">
          <div
            class="card-header d-flex justify-content-between align-items-center"
            id="card_chamadas_togget"
            style="cursor: pointer"
          >
            <div>
              <h2 class="text-primary mb-0">Configuração de chamada</h2>
              <small class="text-muted">
                Clique para expandir as configurações
              </small>
            </div>

            <i
              id="icon-card-chamadas"
              class="bi bi-chevron-down fs-4 text-secondary"
            ></i>
          </div>
          <div class="card-body d-none" id="card_chamadas">
            <form action="" method="POST" id="form_chamadas">
              <div class="mb-3">
                <label class="form-label text-secondary"
                  >Mensagem que será enviar apos recusar</label
                >
                <div class="input-group">
                  <span class="input-group-text border-primary border-2"
                    >Message</span
                  >
                  <input
                    type="text"
                    id="msg_chamadas"
                    name="msg_chamadas"
                    class="form-control border-primary border-2"
                    placeholder="Não atendo ligações"
                  />
                </div>
                <div class="form-check mt-2">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="chamadas_status"
                    name="chamadas_status"
                  />
                  <label class="form-check-label" for="chamadas-status"
                    >Status</label
                  >
                </div>
              </div>
              <div class="d-flex justify-content-center">
                <button class="btn btn-sm btn-success">Salvar</button>
              </div>
            </form>
          </div>
        </div>

        <div class="card card-instance mb-3">
          <div
            class="card-header d-flex justify-content-between align-items-center"
            id="card_proxy_togget"
            style="cursor: pointer"
          >
            <div>
              <h2 class="text-primary mb-0">Configuração de proxy</h2>
              <small class="text-muted">
                Clique para expandir as configurações
              </small>
            </div>

            <i
              id="icon-card-proxy"
              class="bi bi-chevron-down fs-4 text-secondary"
            ></i>
          </div>
          <div class="card-body d-none" id="card_proxy">
            <form action="" method="POST" id="form_proxy">
              <div class="row mb-3">
                <div class="mb-3 col-6">
                  <div class="input-group">
                    <span class="input-group-text border-primary border-2"
                      >Protocol:</span
                    >
                    <input
                      type="text"
                      id="proxy_protocol"
                      name="proxy_protocol"
                      class="form-control border-primary border-2"
                      placeholder="ex: http"
                    />
                  </div>
                </div>

                <div class="mb-3 col-6">
                  <div class="input-group">
                    <span class="input-group-text border-primary border-2"
                      >Username:</span
                    >
                    <input
                      type="text"
                      id="proxy_username"
                      name="proxy_username"
                      class="form-control border-primary border-2"
                      placeholder="ex: user123"
                    />
                  </div>
                </div>

                <div class="mb-3 col-6">
                  <div class="input-group">
                    <span class="input-group-text border-primary border-2"
                      >Password:</span
                    >
                    <input
                      type="text"
                      id="proxy_password"
                      name="proxy_password"
                      class="form-control border-primary border-2"
                      placeholder="ex: pass123"
                    />
                  </div>
                </div>

                <div class="mb-3 col-6">
                  <div class="input-group">
                    <span class="input-group-text border-primary border-2"
                      >Port:</span
                    >
                    <input
                      type="number"
                      id="proxy_port"
                      name="proxy_port"
                      class="form-control border-primary border-2"
                      placeholder="ex: 8080"
                    />
                  </div>
                </div>

                <div class="mb-3 col-6">
                  <div class="input-group">
                    <span class="input-group-text border-primary border-2"
                      >Host:</span
                    >
                    <input
                      type="text"
                      id="proxy_host"
                      name="proxy_host"
                      class="form-control border-primary border-2"
                      placeholder="ex: 127.0.0.1"
                    />
                  </div>
                </div>
                <div class="mb-3 col-6">
                  <div class="input-group">
                    <span class="input-group-text border-primary border-2"
                      >Status:</span
                    >
                    <select
                      class="form-control border-primary border-2"
                      name="proxy_status"
                      id="proxy_status"
                    >
                      <option value="true">Ativo</option>
                      <option value="false">Inativo</option>
                    </select>
                  </div>
                </div>
              </div>
              <div class="d-flex justify-content-center">
                <button class="btn btn-sm btn-success">Salvar</button>
              </div>
            </form>
          </div>
        </div>

        <div class="card card-instance mb-3" id="testador">
          <div
            class="card-header d-flex justify-content-between align-items-center"
            id="card_testador_togget"
            style="cursor: pointer"
          >
            <div>
              <h2 class="text-primary mb-0">Testar endpoints</h2>
              <small class="text-muted">
                Envie mensagens e consulte contatos, chats e grupos sem sair do painel
              </small>
            </div>
            <i
              id="icon-card-testador"
              class="bi bi-chevron-down fs-4 text-secondary"
            ></i>
          </div>
          <div class="card-body d-none" id="card_testador">
            <div class="row g-2 mb-2">
              <div class="col-md-4">
                <label class="form-label text-secondary">Número (para {{jid}})</label>
                <input
                  type="text"
                  id="testador_numero"
                  class="form-control border-primary border-2"
                  placeholder="5511999999999"
                />
              </div>
              <div class="col-md-8">
                <label class="form-label text-secondary">Requisição pronta</label>
                <select
                  id="testador_preset"
                  class="form-select border-primary border-2"
                ></select>
              </div>
            </div>
            <div class="input-group mb-2">
              <select id="testador_metodo" class="form-select" style="max-width: 110px">
                <option>GET</option>
                <option>POST</option>
                <option>PUT</option>
                <option>DELETE</option>
              </select>
              <span class="input-group-text">/api</span>
              <input
                type="text"
                id="testador_caminho"
                class="form-control border-primary border-2"
              />
              <button type="button" id="testador_enviar" class="btn btn-success">
                <i class="bi bi-send me-1"></i> Enviar
              </button>
            </div>
            <label class="form-label text-secondary">Corpo (JSON)</label>
            <textarea
              id="testador_corpo"
              rows="8"
              class="form-control border-primary border-2 mb-3"
              style="font-family: monospace; font-size: 0.85rem"
              spellcheck="false"
            ></textarea>
            <div class="d-flex align-items-center gap-2 mb-1">
              <span class="text-secondary">Resposta</span>
              <span id="testador_status" class="badge bg-secondary">-</span>
              <button type="button" id="testador_copiar" class="btn btn-sm btn-outline-info ms-auto">
                <i class="bi bi-clipboard me-1"></i> Copiar
              </button>
            </div>
            <pre
              id="testador_resposta"
              class="p-2 border rounded"
              style="max-height: 360px; overflow: auto; font-size: 0.8rem; color: #e6edf3; background: transparent"
            ></pre>
          </div>
        </div>
      </section>
    </div>

    <div
      class="toast-container position-fixed bottom-0 end-0 p-3"
      id="containerNotificacoes"
      style="z-index: 1080"
    ></div>

    <script src="/js/user.js"></script>
    <script src="/js/testador.js"></script>
  </body>
</html>
