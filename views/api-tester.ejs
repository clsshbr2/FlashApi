<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <title>Testador de endpoints | Flash API</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/futuristic-theme.css" rel="stylesheet" />
    <link href="/css/api-tester.css" rel="stylesheet" />
  </head>

  <body class="panel-page dashboard-page api-tester-page">
    <nav class="navbar navbar-dark bg-black border-bottom border-primary">
      <div class="container-fluid">
        <span class="navbar-brand text-primary fw-bold">
          <i class="bi bi-lightning-charge-fill me-1"></i> Flash API
          <span class="text-secondary fw-normal ms-2 d-none d-sm-inline">Testador de endpoints</span>
        </span>
        <div class="d-flex align-items-center gap-2">
          <a href="/manager/dashboard" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Painel
          </a>
          <a href="/manager/logout" class="btn btn-sm btn-danger">
            <i class="bi bi-box-arrow-right me-1"></i> Sair
          </a>
        </div>
      </div>
    </nav>

    <!-- Dados para o script (a chave global só existe no modo admin) -->
    <div
      id="testerConfig"
      hidden
      data-modo="<%= modo %>"
      data-apikey="<%= apikey %>"
      data-apikey-global="<%= apikeyGlobal %>"
    ></div>

    <div class="tester-layout">
      <!-- Lista de requisições (vinda da coleção do Postman) -->
      <aside class="tester-sidebar" aria-label="Requisições">
        <div class="tester-sidebar-top">
          <input type="search" id="filtro" class="form-control form-control-sm" placeholder="Buscar requisição ou rota…" autocomplete="off" />
          <small class="text-muted d-block mt-2" id="contagem">Carregando coleção…</small>
        </div>
        <nav id="arvore" class="tester-tree"></nav>
      </aside>

      <main class="tester-main">
        <!-- Variáveis -->
        <section class="tester-vars">
          <% if (modo === 'admin') { %>
          <label class="tester-var">
            <span>Sessão <code>{{apikey}}</code></span>
            <select id="varSessao" class="form-select form-select-sm">
              <% if (sessoes.length === 0) { %>
              <option value="">Nenhuma sessão cadastrada</option>
              <% } %>
              <% sessoes.forEach(function (s) { %>
              <option value="<%= s.apikey %>"><%= s.nome %></option>
              <% }) %>
            </select>
          </label>
          <% } else { %>
          <div class="tester-var">
            <span>Sessão <code>{{apikey}}</code></span>
            <span class="tester-var-fixed">sua sessão</span>
          </div>
          <% } %>
          <label class="tester-var">
            <span>Número de teste <code>{{RemoteJid}}</code></span>
            <input type="text" id="varNumero" class="form-control form-control-sm" placeholder="5511999999999" autocomplete="off" />
          </label>
        </section>

        <!-- Requisição -->
        <section class="tester-request">
          <h1 id="nomeRequisicao" class="tester-title">Escolha uma requisição à esquerda</h1>
          <div class="tester-urlbar">
            <select id="metodo" class="form-select tester-method" aria-label="Método">
              <option>GET</option>
              <option>POST</option>
              <option>PUT</option>
              <option>DELETE</option>
            </select>
            <span class="tester-base">/api</span>
            <input type="text" id="caminho" class="form-control tester-path" placeholder="/session/status" spellcheck="false" aria-label="Rota" />
            <button type="button" id="enviar" class="btn btn-primary tester-send" title="Ctrl+Enter">
              <i class="bi bi-send-fill me-1"></i> Enviar
            </button>
          </div>
          <div id="avisoAdmin" class="tester-warning" hidden>
            <i class="bi bi-shield-lock me-1"></i>
            Esta rota exige a apikey global e só funciona logado como administrador.
          </div>

          <ul class="nav nav-tabs tester-tabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-aba="corpo" type="button">Corpo (JSON)</button></li>
            <li class="nav-item"><button class="nav-link" data-aba="params" type="button">Parâmetros <span id="qtdParams" class="badge bg-secondary"></span></button></li>
            <li class="nav-item"><button class="nav-link" data-aba="headers" type="button">Headers</button></li>
          </ul>
          <div class="tester-panel" data-painel="corpo">
            <textarea id="corpo" class="form-control tester-code" rows="12" spellcheck="false" placeholder="Sem corpo"></textarea>
            <div class="tester-panel-actions">
              <button type="button" id="formatar" class="btn btn-sm btn-outline-secondary"><i class="bi bi-braces me-1"></i> Formatar JSON</button>
              <span id="erroJson" class="text-danger small"></span>
            </div>
          </div>
          <div class="tester-panel" data-painel="params" hidden>
            <p class="text-muted small mb-2">Partes da rota como <code>:id_message</code>. Os valores entram no caminho ao enviar.</p>
            <div id="params"></div>
          </div>
          <div class="tester-panel" data-painel="headers" hidden>
            <div class="tester-kv"><code>apikey</code><span id="headerApikey" class="text-secondary"></span></div>
            <div class="tester-kv"><code>Content-Type</code><span class="text-secondary">application/json (quando há corpo)</span></div>
          </div>
        </section>

        <!-- Resposta -->
        <section class="tester-response" aria-live="polite">
          <div class="tester-response-head">
            <h2>Resposta</h2>
            <span id="status" class="badge bg-secondary">—</span>
            <span id="tempo" class="text-muted small"></span>
            <div class="ms-auto d-flex gap-2">
              <button type="button" id="copiar" class="btn btn-sm btn-outline-secondary"><i class="bi bi-clipboard me-1"></i> Copiar</button>
              <button type="button" id="copiarCurl" class="btn btn-sm btn-outline-secondary"><i class="bi bi-terminal me-1"></i> cURL</button>
            </div>
          </div>
          <img id="respostaImagem" alt="Imagem retornada pela API" hidden />
          <pre id="resposta" class="tester-code tester-output">Envie uma requisição para ver a resposta aqui.</pre>
        </section>
      </main>
    </div>

    <script src="/js/api-tester.js"></script>
  </body>
</html>
